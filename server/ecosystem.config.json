{
  "apps": [
    {
      "name": "fixindia-api",
      "script": "bun",
      "args": "run src/index.ts",
      "interpreter": "none",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production",
        "PORT": 6969
      },
      "error_file": "logs/error.log",
      "out_file": "logs/output.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s"
    },
    {
      "name": "fixindia-admin-api",
      "script": "bun",
      "args": "run src/admin.ts",
      "interpreter": "none",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production",
        "ADMIN_PORT": 6970
      },
      "error_file": "logs/admin_error.log",
      "out_file": "logs/admin_output.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s"
    }
  ]
}
