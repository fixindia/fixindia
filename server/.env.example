# ─────────────────────────────────────────────────────────────
# FixIndia.org — Backend environment (server/.env)
# Copy to server/.env and fill in real values. NEVER commit .env.
# Rotate anything that leaks (see docs/SECRET-ROTATION.md).
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL + PostGIS) — required
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Environment: "production" enables strict checks (ADMIN_KEY/CLERK required, etc.)
NODE_ENV=production

# Ports (optional; defaults shown)
PORT=6969
ADMIN_PORT=6970

# ── Security ──
# Admin key for the admin API fallback auth. Must be >= 32 chars in production.
# Generate with: openssl rand -hex 32
ADMIN_KEY=your-secure-admin-token

# Admin SQL shell is DISABLED unless this is exactly "true". Leave unset in
# normal operation; enable only for deliberate, supervised debugging.
ADMIN_SQL_ENABLED=false

# ── Clerk Authentication (required in production for JWT verification) ──
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key

# ── Cloudflare Access (optional; admin API SSO) ──
# When set, the admin API accepts Cloudflare Access JWTs in addition to ADMIN_KEY.
CLOUDFLARE_TEAM_DOMAIN=your-team
CLOUDFLARE_AUD=your-application-audience-tag

# ── Storj DCS (S3 Compatible Storage) — required ──
STORJ_ACCESS_KEY=your-access-key
STORJ_SECRET_KEY=your-secret-key
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=civicmap

# ── AI Providers (at least GROQ_API_KEYS required for news scraping) ──
# Comma-separated for round-robin key rotation.
GROQ_API_KEYS=gsk_xxx,gsk_yyy
OPENROUTER_API_KEYS=sk-or-v1-xxx
